# Corade device platform configuration.
# The token is read from CORADE_AGENT_TOKEN instead of being stored here.
control:
  mode: "device-platform"
  url: "https://panel.example.com"
  token_env: "CORADE_AGENT_TOKEN"
  machine_id: "mch_example"
  panel_public_key: "replace-with-panel-ed25519-public-key"

kernel:
  type: "xray"
  log_level: "warn"

log:
  level: "info"
  output: "stdout"

# Optional process health endpoint. Set to 0 to disable it.
health_port: 65530

# Standalone mode remains available for local operation. It cannot be combined
# with control settings. See the standalone section in the project README.
